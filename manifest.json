{
  "manifest_version": 3,
  "name": "Context Stack",
  "version": "1.1.0",
  "description": "Captura URLs de navegación, antepone https://r.jina.ai/ para convertirlas a Markdown limpio y acumula contexto en Context Stack para LLMs.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Context Stack",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "add-current-tab": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Command+Shift+S"
      },
      "description": "Agregar la pestaña activa a Context Stack"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
